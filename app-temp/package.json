{
  "name": "obr-quest-companion",
  "author": {
    "name": "codeblivion"
  },
  "version": "1.0.5",
  "description": "Quest companion for The Elder Scrolls IV: Oblivion Remastered",
  "desktopName": "OBR Quest Companion",
  "main": "main.js",
  "build": {
    "appId": "com.codeblivion.questcompanion",
    "productName": "OBR Quest Companion",
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "images/icon.png",
      "artifactName": "OBR-Quest-Companion-Setup-${version}.${ext}"
    },
    "nsis": {
      "differentialPackage": false
    },
    "linux": {
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "icon": "images/icon.png",
      "artifactName": "OBR-Quest-Companion-Setup-${version}.${ext}"
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../rust/obr-save-wasm --release --target nodejs --out-dir ../../app/generated/obr-save-wasm --out-name obr_save_wasm --no-opt 2>&1",
    "start": "electron .",
    "dist": "npm run build:wasm && electron-builder --publish never",
    "release": "npm run dist"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "wasm-pack": "^0.15.0"
  }
}
